from faker import Faker
import pandas as pd
import random

fake = Faker('es_CO')

def generar_datos(n=1000):
    data = []
    for _ in range(n):
        data.append({
            "fecha": fake.date_this_year(),
            "hora": fake.time(),
            "localidad": fake.random_element(elements=("Chapinero", "Kennedy", "Suba", "Usaquen", "Bosa", "Engativa")),
            "modalidad": fake.random_element(elements=("Atraco", "Raponazo", "Cosquilleo", "Fleteo")),
            "arma": fake.random_element(elements=("Arma blanca", "Sin arma", "Arma de fuego", "Escopolamina")),
        })
    df = pd.DataFrame(data)
    df.to_csv("data/hurtos_simulados.csv", index=False)
    print(f"Se generaron {n} registros")

if __name__ == "__main__":
    generar_datos()
